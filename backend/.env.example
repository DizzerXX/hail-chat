APP_NAME=TDEChat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8010
APP_FRONTEND_URL=http://localhost:4300

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# 'daily' rotates logs into one file per day and keeps LOG_DAILY_DAYS of history,
# so storage/logs never grows unbounded. Use 'single' only for local debugging.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=tdechat
DB_USERNAME=tdechat
DB_PASSWORD=tdechat

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Seconds after a visitor closes their browser tab before the idle sweep
# abandons the chat (a refresh reconnects and cancels it well within this).
CHAT_VISITOR_LEFT_GRACE=30

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

MITEL_ENABLED=false
MITEL_BASE_URL=
MITEL_AUTH_URL=
MITEL_CLIENT_ID=
MITEL_CLIENT_SECRET=
MITEL_TENANT=
MITEL_VERIFY_SSL=true
MITEL_POLL_INTERVAL=15

TRANSLATION=false
TRANSLATION_METHOD=none
# Base URL of the SeaLLM/Ollama translation service, e.g. http://172.17.0.1:5555
TRANSLATION_API_URL=
TRANSLATION_TIMEOUT=60
TRANSLATION_CACHE_TTL=86400

# Licenses are synced from the platform and spent one per agent. There is no
# per-installation key: the platform id and its access token identify us.
LICENSE_MANAGER_URL=
LICENSE_PLATFORM_SLUG=
LICENSE_PLATFORM_ID=
LICENSE_PLATFORM_ACCESS_TOKEN=
